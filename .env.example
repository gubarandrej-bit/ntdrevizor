# Ревизор НТД — пример конфигурации
# Скопируйте в .env и заполните ключи. Пустые ключи допустимы:
# соответствующие облачные модели будут недоступны, проверки без ИИ выполнятся.

APP_NAME=Ревизор НТД
APP_HOST=0.0.0.0
APP_PORT=8080
APP_SECRET=
# Если пусто — секрет создаётся при первом запуске в data/secret.key

DATA_DIR=./data
UPLOAD_MAX_MB=120

# Учётная запись администратора при первой инициализации БД
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Revizor#2026
ADMIN_FULL_NAME=Администратор

# ---------- Облачные провайдеры (бесплатные тарифы) ----------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (бесплатные модели с суффиксом :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GigaChat (Сбер), физлица: https://developers.sber.ru/gigachat
# Authorization Key = base64(client_id:client_secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# YandexGPT: https://console.yandex.cloud/
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Универсальный OpenAI-совместимый endpoint (LM Studio, vLLM, Cloudflare и т.п.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---------- Локальный ИИ ----------
# Ollama (если установлен): http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Прямой GGUF через llama-cpp-python (опционально)
# Для AMD FX-8120 собирать БЕЗ AVX2/FMA/BMI2/F16C — см. INSTALL.md
LOCAL_GGUF_PATH=
LOCAL_GGUF_N_CTX=2048
LOCAL_GGUF_N_THREADS=4

# Проверка актуальности НТД по сети (docs.cntd.ru / pravo.gov.ru)
NTD_ONLINE_CHECK=1
NTD_ONLINE_TIMEOUT=12

# OCR для сканированных PDF (нужен tesseract-ocr + tesseract-ocr-rus)
OCR_ENABLED=1

# Разбор PDF (защита от «зависания» на сложных векторных страницах)
PDF_TABLE_BUDGET=15
PDF_TABLE_PAGE_TIMEOUT=6
PDF_TEXT_BUDGET=60
PDF_TEXT_PAGE_TIMEOUT=2.5
